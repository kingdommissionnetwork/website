# Backend API Environment Variables (Cloudflare Pages / Local Worker)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key-here
JWT_SECRET=generate-a-secure-random-64-character-jwt-secret-here

# Optional: Seed Administrator Account
SEED_ADMIN_EMAIL=admin@kingdommissionsnetwork.org
SEED_ADMIN_PASSWORD=generate-strong-admin-password-here

# Payment & Email Integrations
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
WISE_API_TOKEN=your-wise-api-token-here
SENTRY_DSN=https://your-sentry-dsn@sentry.io/xxx
