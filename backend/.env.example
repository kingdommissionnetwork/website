# Backend API Environment Variables (Cloudflare Worker / local dev)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
JWT_SECRET=generate-a-secure-random-64-character-jwt-secret-here

# Admin provisioning: no seed env vars — `npm run seed` creates demo users with
# random passwords; provision real admins via POST /api/admin/invite.

# Payment & Email Integrations
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
WISE_API_TOKEN=your-wise-api-token-here
SENTRY_DSN=https://your-sentry-dsn@sentry.io/xxx

# KCB Buni M-Pesa Express (STK Push) — sandbox vs production
# Keep KCB_BUNI_ENV=sandbox until KCB go-live approval; STK stays 503-locked
# and UAT pushes never reach real handsets. Production flip:
#   KCB_BUNI_ENV=production (+ VITE_ENABLE_STK_PUSH=true on the frontend)
KCB_BUNI_CONSUMER_KEY=your-kcb-buni-consumer-key
KCB_BUNI_CONSUMER_SECRET=your-kcb-buni-consumer-secret
KCB_BUNI_ENV=sandbox
# Optional override; defaults to https://api.buni.kcbgroup.com/mm/api/request/1.0.0/stkpush
# KCB_BUNI_API_URL=https://api.buni.kcbgroup.com/mm/api/request/1.0.0/stkpush

# Provider webhook guard (REQUIRED in production — callbacks fail closed):
# Generate with: openssl rand -hex 32
# MPESA_WEBHOOK_SECRET=your-long-random-webhook-secret
# Daraja C2B / KCB IPN / KCB STK-callback must send header x-webhook-secret.
# Unset is allowed only for local dev / tests (with ENVIRONMENT!=production).
# Durable STK sessions require table mpesa_stk_sessions — run drizzle/0002_mpesa_stk_sessions.sql
